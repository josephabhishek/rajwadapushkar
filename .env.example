# Copy this file to .env.local and fill it in. .env.local is never committed.
# Restart the dev server after changing anything here.

# ─── Enquiry delivery ────────────────────────────────────────────────────────
# Free key from https://resend.com — 3,000 emails a month, no card required.
# Without both of these the contact form says so honestly and offers WhatsApp
# instead. It never silently swallows an enquiry.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=

# Optional. Only set this once the resort's own domain is verified in Resend.
# Until then leave it blank and Resend's shared sender is used.
# ENQUIRY_FROM="Rajwada Website <website@rajwadaresortpushkar.com>"

# ─── Reservations contact ────────────────────────────────────────────────────
# WhatsApp must be digits only, with country code, no + or spaces.
# India is 91, so 98765 43210 becomes 919876543210.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=

# ─── Site ────────────────────────────────────────────────────────────────────
# The live URL, no trailing slash. Used for canonical tags, sitemap and
# social share cards.
NEXT_PUBLIC_SITE_URL=https://rajwadaresortpushkar.com
